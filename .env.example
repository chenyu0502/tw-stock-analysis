# 複製為 .env.local 後填寫。

# ---- 前端（VITE_ 開頭，會編進前端程式碼） ----
# 本機開發：保留 VITE_USE_EMULATOR=true，搭配 npm run emulators，不需要真的 Firebase 專案。
# 正式環境：改為 false，並填入與 Claude Flow 完全相同的 Firebase 設定（兩邊才會共用登入狀態）。
VITE_USE_EMULATOR=true
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=demo-claude-flow
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Claude Flow 的網址。正式環境直接打開本專案網址時，會轉回這裡的 /stock/。本機開發不需要。
VITE_CLAUDE_FLOW_URL=

# ---- 伺服器端（api/ 使用，沒有 VITE_ 前綴，不會進前端） ----
# 都是選填：未設定時對應區塊會顯示提示，其餘功能不受影響。
FINMIND_TOKEN=
GEMINI_API_KEY=
GEMINI_MODEL=
